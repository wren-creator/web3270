# WebTerm/3270 Bridge — configuration reference
# Copy to .env and edit, or run ./setup.sh to configure interactively.
# .env is gitignored and never committed.

# Host port the bridge UI is accessible on in your browser.
# Change this if 8081 is already in use on your machine.
BRIDGE_HOST_PORT=8081

# Shared secret POST /api/macro-run requires in the X-Macro-Run-Key header.
# Fails closed if unset — see routes/macro-run.js. Generate one with:
#   openssl rand -hex 32
# Must match the MACRO_RUN_KEY constant in the calling VBA module
# (~/git/my-code/vbmacro/new/RM2P_HTTP_Override.bas).
MACRO_RUN_API_KEY=
