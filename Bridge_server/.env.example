# WebTerm/3270 Bridge — configuration reference
# Copy to .env and edit, or run ./setup.sh to configure interactively.
# .env is gitignored and never committed.

# Host port the bridge UI is accessible on in your browser.
# Change this if 8081 is already in use on your machine.
BRIDGE_HOST_PORT=8081

# ── Hosted paid-tier product (webterm-3270.com) ────────────────────
# Leave unset for the internal/OpenShift deployment — it has no
# account system and stays on the shared security-tools password.
# BRIDGE_MULTI_TENANT=true

# Postgres connection string for the accounts/billing schema (db/schema.sql).
# DATABASE_URL=postgres://user:password@localhost:5432/webterm3270
# Render's managed Postgres needs SSL; local dev usually doesn't have a cert.
# DATABASE_SSL=false
