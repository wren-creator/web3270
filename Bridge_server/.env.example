# WebTerm/3270 Bridge — configuration reference
# Copy to .env and edit, or run ./setup.sh to configure interactively.
# .env is gitignored and never committed.

# Host port the bridge UI is accessible on in your browser.
# Change this if 8081 is already in use on your machine.
BRIDGE_HOST_PORT=8081

# ── Hosted paid-tier product (webterm-3270.com) ────────────────────
# Leave unset for the internal/OpenShift deployment — it has no
# account system and stays on the shared security-tools password.
# BRIDGE_MULTI_TENANT=true

# Postgres connection string for the accounts/billing schema (db/schema.sql).
# DATABASE_URL=postgres://user:password@localhost:5432/webterm3270
# Render's managed Postgres needs SSL; local dev usually doesn't have a cert.
# DATABASE_SSL=false

# SMS delivery for signup phone verification (api.telnyx.com).
# TELNYX_API_KEY=
# TELNYX_FROM_NUMBER=+15555550100

# Session cookie signing key — any long random string, generate one
# per deployment, never reuse the dev value in production.
# SESSION_SECRET=
# Set to false only for local http:// dev; leave unset/true in production
# so the session cookie requires https.
# COOKIE_SECURE=false

# SMTP relay for post-login email verification.
# SMTP_HOST=smtp.forwardemail.net
# SMTP_PORT=465
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=

# Where full-tier disclaimer acceptances get emailed so Britley can
# reach out manually — full tier is not pure self-serve. Reuses the
# SMTP relay above.
# ADMIN_NOTIFY_EMAIL=

# PayPal subscriptions billing. Defaults to sandbox so nothing
# accidentally points at real money. Plan ids are created once per
# environment (one PayPal "plan" per tier) and referenced here.
# PUBLIC_BASE_URL=https://webterm-3270.com
# PAYPAL_ENV=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_PLAN_ID_BASE=
# PAYPAL_PLAN_ID_TRAINING=
# PAYPAL_PLAN_ID_FULL=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_LIVE_CLIENT_ID=
# PAYPAL_LIVE_CLIENT_SECRET=
# PAYPAL_LIVE_PLAN_ID_BASE=
# PAYPAL_LIVE_PLAN_ID_TRAINING=
# PAYPAL_LIVE_PLAN_ID_FULL=
# PAYPAL_LIVE_WEBHOOK_ID=
