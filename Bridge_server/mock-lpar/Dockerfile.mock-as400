FROM node:20-alpine

WORKDIR /app

# Only copy what the mock AS/400 daemon needs — no bridge deps required.
# rpg/ is the RPG interpreter + its .rpgle/.dspf program source, both
# require()'d and read from disk at startup by mock-as400.js.
COPY mock-lpar/mock-as400.js ./mock-lpar/mock-as400.js
COPY mock-lpar/mock-as400-httpadmin.js ./mock-lpar/mock-as400-httpadmin.js
COPY mock-lpar/rpg ./mock-lpar/rpg

# Self-signed cert for the HTTPS admin port (2010). Throwaway, mock only.
RUN apk add --no-cache openssl \
 && mkdir -p /app/certs \
 && openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
      -subj "/CN=AS400MOCK" \
      -keyout /app/certs/key.pem -out /app/certs/cert.pem \
 && chmod 644 /app/certs/key.pem \
 && apk del openssl

RUN addgroup -S mockas400 && adduser -S mockas400 -G mockas400
USER mockas400

EXPOSE 3272 2001 2010

ENV MOCK_AS400_PORT=3272 \
    MOCK_AS400_SYSID=AS400MOCK \
    LOG_LEVEL=info

CMD ["node", "mock-lpar/mock-as400.js"]
