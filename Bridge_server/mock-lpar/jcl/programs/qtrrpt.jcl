//QTRRPT   JOB (DEMO),
//             'QUARTERLY REPORT',
//             CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*
//STEP1    EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=DEMO.DATA.INPUT,DISP=SHR
//SORTOUT  DD DSN=DEMO.WORK.DATA,
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(2,1),RLSE),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920)
//SYSIN    DD *
  SORT FIELDS=(1,10,CH,A)
/*
//*
//STEP2    EXEC PGM=REPORT
//SYSPRINT DD SYSOUT=*
//REPTIN   DD DSN=DEMO.WORK.DATA,DISP=SHR
//REPTOUT  DD DSN=DEMO.DATA.OUTPUT,DISP=OLD
